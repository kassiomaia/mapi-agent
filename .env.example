# Copie este arquivo para .env e preencha. O npm start carrega o .env automaticamente.
# Nunca faça commit do .env.

# Chave da API da Anthropic. Crie a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Opcional: modelo usado pelo agente. Padrão: claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: limite de passos do loop do agente. Padrão: 8
# AGENT_MAX_STEPS=8

# Opcional: porta do servidor HTTP e WebSocket. Padrão: 3000
# PORT=3000

# Chave da API Tavily, usada pela busca de passagens e pelo plano de viagem (https://tavily.com).
# Sem ela, a ferramenta search_flights responde com erro.
# TAVILY=tvly-coloque-sua-chave-aqui

# Opcional: contato (e-mail ou site) enviado no User-Agent às APIs da Wikimedia,
# usadas pelas fotos. Sem contato, o limite é de 10 requisições por minuto;
# com contato, sobe para 200.
# WIKIMEDIA_CONTACT=https://exemplo.com/contato
