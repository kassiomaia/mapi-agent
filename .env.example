# Copie este arquivo para .env e preencha. O npm start carrega o .env automaticamente.
# Nunca faça commit do .env.

# Provedor: "anthropic" (padrão, API direta) ou "bedrock" (Claude no Amazon Bedrock)
ANTHROPIC_PROVIDER=anthropic

# --- Provedor anthropic (API direta) ---
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# --- Provedor bedrock (Amazon Bedrock) ---
# Região com Claude disponível no Bedrock, ex.: us-east-1
AWS_REGION=us-east-1
# Credenciais: use UMA das opções abaixo
# AWS_BEARER_TOKEN_BEDROCK=coloque-o-token-aqui
# AWS_PROFILE=meu-perfil
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Opcional: modelo usado pelo agente.
# Padrão: claude-haiku-5-5 (anthropic) ou global.anthropic.claude-haiku-5-5 (bedrock)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Chave da API Tavily, usada pela ferramenta de busca de passagens (https://tavily.com).
# Sem ela, a ferramenta search_flights responde com erro.
# TAVILY=tvly-coloque-sua-chave-aqui

# Opcional: contato (e-mail ou site) enviado no User-Agent às APIs da Wikimedia,
# usadas pela ferramenta de fotos. Sem contato, o limite é de 10 requisições por minuto;
# com contato, sobe para 200.
# WIKIMEDIA_CONTACT=https://exemplo.com/contato
