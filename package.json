{
  "name": "mapi-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mapi, agente pessoal de planejamento de férias com a API da Anthropic (Bedrock ou API direta), em TypeScript com Node.js",
  "license": "MIT",
  "scripts": {
    "build:client": "node --import tsx scripts/build-client.ts && tailwindcss -i src/client/styles/globals.css -o public/build/app.css --minify",
    "start": "npm run build:client && node --env-file-if-exists=.env --import tsx src/index.ts",
    "example": "node --env-file-if-exists=.env --import tsx example/index.ts",
    "example:01": "node --env-file-if-exists=.env --import tsx example/01-model-call.ts",
    "example:02": "node --env-file-if-exists=.env --import tsx example/02-tool-definition.ts",
    "example:03": "node --env-file-if-exists=.env --import tsx example/03-tool-result.ts",
    "example:04": "node --env-file-if-exists=.env --import tsx example/04-agent-loop.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.3",
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@hono/node-ws": "^1.3.2",
    "@ui-sdk/core": "^0.1.0-beta.16",
    "@ui-sdk/react": "^0.1.0-beta.16",
    "clsx": "^2.1.1",
    "geographiclib": "^1.52.2",
    "hono": "^4.13.21",
    "leaflet": "^1.9.4",
    "lucide-react": "0.577.0",
    "motion": "12.26.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
